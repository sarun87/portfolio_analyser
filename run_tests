set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ ! -x ".venv/bin/python" ]]; then
  echo "Missing backend environment. Run: python3 -m venv .venv && .venv/bin/pip install -r backend/requirements.txt"
  exit 1
fi

if [[ ! -d "frontend/node_modules" ]]; then
  echo "Missing frontend dependencies. Run: cd frontend && npm install"
  exit 1
fi

MATPLOTLIB_CACHE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/portfolio-analyser-matplotlib.XXXXXX")"
trap 'rm -rf "$MATPLOTLIB_CACHE_DIR"' EXIT

echo "Running backend tests..."
MPLCONFIGDIR="$MATPLOTLIB_CACHE_DIR" PYTHONPATH=. .venv/bin/python -m pytest backend/tests "$@"

echo "Running frontend tests..."
(cd frontend && npm test -- --run)
