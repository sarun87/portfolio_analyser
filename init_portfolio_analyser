#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

command -v python3 >/dev/null 2>&1 || {
  echo "python3 is required but was not found."
  exit 1
}

command -v npm >/dev/null 2>&1 || {
  echo "npm is required but was not found."
  exit 1
}

echo "Creating Python virtual environment..."
python3 -m venv .venv

echo "Installing backend dependencies..."
.venv/bin/pip install -r backend/requirements.txt

echo "Installing frontend dependencies..."
cd frontend
npm install

echo "Building frontend..."
npm run build

cd "$ROOT_DIR"
mkdir -p data
mkdir -p logs

echo "Portfolio Analyser is initialized."
echo "Start it with:"
echo "  ./run_portfolio_analyser"
echo "For HTTPS production deployment, see:"
echo "  PRODUCTION_HTTPS.md"
echo "For interactive self-signed TLS setup on a private network:"
echo "  ./setup_self_signed_production_tls"
echo "For a trusted-network HTTP test only:"
echo "  ./run_portfolio_analyser --insecure"
