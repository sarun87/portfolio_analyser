set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

CERT_DIR="$ROOT_DIR/certs/self-signed"
CERT_FILE="$CERT_DIR/portfolio-analyser.crt"
KEY_FILE="$CERT_DIR/portfolio-analyser.key"
ENV_FILE="$ROOT_DIR/portfolio-production.env"
LAUNCHER_FILE="$ROOT_DIR/run_self_signed_production"
OPENSSL_BIN="openssl"

install_openssl() {
  if command -v "$OPENSSL_BIN" >/dev/null 2>&1; then
    return
  fi

  case "$(uname -s)" in
    Darwin)
      command -v brew >/dev/null 2>&1 || {
        echo "OpenSSL is required. Install Homebrew from https://brew.sh, then rerun this script."
        exit 1
      }
      brew install openssl@3
      OPENSSL_BIN="$(brew --prefix openssl@3)/bin/openssl"
      [[ -x "$OPENSSL_BIN" ]] || {
        echo "Homebrew installed OpenSSL but its executable could not be found."
        exit 1
      }
      ;;
    Linux)
      if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update
        sudo apt-get install -y openssl
      elif command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y openssl
      elif command -v yum >/dev/null 2>&1; then
        sudo yum install -y openssl
      elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -Sy --noconfirm openssl
      else
        echo "OpenSSL is required. Install it with your Linux distribution's package manager, then rerun this script."
        exit 1
      fi
      ;;
    *)
      echo "Unsupported operating system. Install OpenSSL and rerun this script."
      exit 1
      ;;
  esac
}

normalize_dns_name() {
  local raw="$1"
  raw="${raw#https://}"
  raw="${raw#http://}"
  raw="${raw%%/*}"
  raw="${raw%%:*}"
  printf '%s' "$raw"
}

valid_dns_name() {
  [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] && [[ "$1" != *".."* ]]
}

valid_ipv4() {
  local ip="$1" part
  local -a parts
  IFS='.' read -r -a parts <<< "$ip"
  [[ "${#parts[@]}" -eq 4 ]] || return 1
  for part in "${parts[@]}"; do
    [[ "$part" =~ ^[0-9]{1,3}$ ]] || return 1
    (( 10#$part <= 255 )) || return 1
  done
}

if [[ ! -x "$ROOT_DIR/.venv/bin/uvicorn" || ! -f "$ROOT_DIR/frontend/dist/index.html" ]]; then
  echo "Initialize and build the application first: ./init_portfolio_analyser"
  exit 1
fi

install_openssl

read -r -p "DNS name or HTTPS URL for the certificate SAN (for example portfolio.example.com): " RAW_DNS_NAME
DNS_NAME="$(normalize_dns_name "$RAW_DNS_NAME")"
if ! valid_dns_name "$DNS_NAME"; then
  echo "Enter a hostname or HTTPS URL with a valid hostname; do not include a path."
  exit 1
fi

read -r -p "IPv4 address for the certificate SAN (for example 192.168.1.20): " IP_ADDRESS
if ! valid_ipv4 "$IP_ADDRESS"; then
  echo "Enter a valid IPv4 address."
  exit 1
fi

read -r -p "HTTPS port [8443]: " HTTPS_PORT
HTTPS_PORT="${HTTPS_PORT:-8443}"
if ! [[ "$HTTPS_PORT" =~ ^[0-9]{1,5}$ ]] || (( 10#$HTTPS_PORT < 1 || 10#$HTTPS_PORT > 65535 )); then
  echo "Enter a valid TCP port between 1 and 65535."
  exit 1
fi

if [[ -e "$CERT_FILE" || -e "$KEY_FILE" ]]; then
  read -r -p "Replace existing self-signed certificate files? [y/N]: " REPLACE_CERTIFICATE
  if [[ "$REPLACE_CERTIFICATE" != "y" && "$REPLACE_CERTIFICATE" != "Y" ]]; then
    echo "No files were changed."
    exit 0
  fi
fi

mkdir -p "$CERT_DIR"
chmod 700 "$CERT_DIR"
OPENSSL_CONFIG="$(mktemp)"
trap 'rm -f "$OPENSSL_CONFIG"' EXIT
printf '%s\n' \
  '[req]' \
  'distinguished_name = distinguished_name' \
  'prompt = no' \
  'x509_extensions = v3_req' \
  '[distinguished_name]' \
  "CN = $DNS_NAME" \
  '[v3_req]' \
  'basicConstraints = critical,CA:FALSE' \
  'keyUsage = critical,digitalSignature,keyEncipherment' \
  'extendedKeyUsage = serverAuth' \
  'subjectAltName = @alt_names' \
  '[alt_names]' \
  "DNS.1 = $DNS_NAME" \
  "IP.1 = $IP_ADDRESS" > "$OPENSSL_CONFIG"

"$OPENSSL_BIN" req -x509 -newkey rsa:4096 -sha256 -nodes -days 825 \
  -keyout "$KEY_FILE" -out "$CERT_FILE" \
  -config "$OPENSSL_CONFIG" -extensions v3_req
chmod 600 "$KEY_FILE"
chmod 644 "$CERT_FILE"

printf '%s\n' \
  '# Generated by setup_self_signed_production_tls. Keep this file private.' \
  'PORTFOLIO_ENV=production' \
  'PORTFOLIO_SESSION_COOKIE_SECURE=true' \
  "PORTFOLIO_TRUSTED_ORIGINS=https://$DNS_NAME:$HTTPS_PORT,https://$IP_ADDRESS:$HTTPS_PORT" \
  'PORTFOLIO_HOST=0.0.0.0' \
  "PORTFOLIO_PORT=$HTTPS_PORT" \
  "PORTFOLIO_SSL_CERTFILE=$CERT_FILE" \
  "PORTFOLIO_SSL_KEYFILE=$KEY_FILE" > "$ENV_FILE"
chmod 600 "$ENV_FILE"

printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -euo pipefail' \
  'ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"' \
  'set -a' \
  'source "$ROOT_DIR/portfolio-production.env"' \
  'set +a' \
  'exec "$ROOT_DIR/run_portfolio_analyser"' > "$LAUNCHER_FILE"
chmod 700 "$LAUNCHER_FILE"

echo
echo "Self-signed TLS is configured for:"
echo "  https://$DNS_NAME:$HTTPS_PORT"
echo "  https://$IP_ADDRESS:$HTTPS_PORT"
echo "Start it with:"
echo "  ./run_self_signed_production"
echo "Browsers will show a certificate warning until this self-signed certificate is trusted on each client."
